{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/properties/:reference", "destination": "/property" }
  ],
  "headers": [
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
